// Blue Unified - Zellij 主题
// 亮蓝色系深色主题，适用于 Zellij 0.44+
//
// 使用方法：
// 1. 将本文件内容复制到 ~/.config/zellij/config.kdl 的 themes {} 块中
// 2. 在 config.kdl 中添加 theme "blue-unified"
// 3. 重启 Zellij

themes {
    "blue-unified" {
        // 普通文字 - 动作名(New, Close, Rename...)和箭头
        text_unselected {
            base 140 170 200
            background 22 30 46
            emphasis_0 50 130 190
            emphasis_1 120 160 200
            emphasis_2 100 145 185
            emphasis_3 80 130 175
        }

        // 选中文本
        text_selected {
            base 80 195 255
            background 22 30 46
            emphasis_0 50 130 190
            emphasis_1 120 160 200
            emphasis_2 100 145 185
            emphasis_3 80 130 175
        }

        // 选中 Pane 边框
        frame_selected {
            base 80 195 255
            background 0 85 165
            emphasis_0 0 85 165
            emphasis_1 0 85 165
            emphasis_2 0 85 165
            emphasis_3 0 85 165
        }

        // 未选中 Pane 边框
        frame_unselected {
            base 60 85 115
            background 22 30 46
            emphasis_0 35 55 80
            emphasis_1 40 60 85
            emphasis_2 30 50 75
            emphasis_3 35 55 80
        }

        // 高亮边框（PANE 模式等）
        frame_highlight {
            base 80 195 255
            background 0 95 175
            emphasis_0 0 95 175
            emphasis_1 0 95 175
            emphasis_2 0 95 175
            emphasis_3 0 95 175
        }

        // 选中 Tab/Ribbon
        ribbon_selected {
            base 0 0 0
            background 255 255 255
            emphasis_0 0 85 165
            emphasis_1 0 85 165
            emphasis_2 0 85 165
            emphasis_3 0 85 165
        }

        // 未选中 Tab/Ribbon
        ribbon_unselected {
            base 0 0 0
            background 80 195 255
            emphasis_0 255 255 255
            emphasis_1 0 0 255
            emphasis_2 255 255 255
            emphasis_3 0 0 0
        }

        // 表格标题
        table_title {
            base 140 170 200
            background 20 40 70
            emphasis_0 0 110 190
            emphasis_1 0 90 165
            emphasis_2 0 75 145
            emphasis_3 0 60 125
        }

        // 表格未选中单元格
        table_cell_unselected {
            base 130 160 195
            background 22 30 46
            emphasis_0 0 110 190
            emphasis_1 0 90 165
            emphasis_2 0 75 145
            emphasis_3 0 60 125
        }

        // 表格选中单元格
        table_cell_selected {
            base 80 195 255
            background 0 90 170
            emphasis_0 0 110 190
            emphasis_1 0 90 165
            emphasis_2 0 75 145
            emphasis_3 0 60 125
        }

        // 列表未选中
        list_unselected {
            base 130 160 195
            background 22 30 46
            emphasis_0 0 110 190
            emphasis_1 0 90 165
            emphasis_2 0 75 145
            emphasis_3 0 60 125
        }

        // 列表选中
        list_selected {
            base 80 195 255
            background 0 90 170
            emphasis_0 0 110 190
            emphasis_1 0 90 165
            emphasis_2 0 75 145
            emphasis_3 0 60 125
        }

        // 成功退出码
        exit_code_success {
            base 80 200 160
            background 22 30 46
            emphasis_0 80 200 160
            emphasis_1 80 200 160
            emphasis_2 80 200 160
            emphasis_3 80 200 160
        }

        // 错误退出码
        exit_code_error {
            base 230 100 100
            background 22 30 46
            emphasis_0 230 100 100
            emphasis_1 230 100 100
            emphasis_2 230 100 100
            emphasis_3 230 100 100
        }

        // 多人协作用户颜色
        multiplayer_user_colors {
            player_1 0 90 170
            player_2 0 110 190
            player_3 0 130 200
            player_4 0 100 180
            player_5 0 75 150
            player_6 0 85 160
            player_7 0 60 130
            player_8 0 120 195
            player_9 0 70 140
            player_10 0 140 210
        }
    }
}
